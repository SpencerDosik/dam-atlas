{
  "name": "dam-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive 3D visualization of US Army Corps of Engineers National Inventory of Dams",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
